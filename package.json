{
  "name": "clean-error-stack",
  "version": "1.0.0",
  "description": "Clean up messy Node.js stack traces in development. Filter out node_modules and internal code, focus only on your code.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./register": "./register.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "register.js"
  ],
  "sideEffects": [
    "./register.js"
  ],
  "scripts": {
    "test": "node test-demo.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umit-ulusoy/clean-error-stack.git"
  },
  "bugs": {
    "url": "https://github.com/umit-ulusoy/clean-error-stack/issues"
  },
  "homepage": "https://github.com/umit-ulusoy/clean-error-stack#readme",
  "keywords": [
    "error",
    "stack",
    "trace",
    "clean",
    "filter",
    "debug",
    "development",
    "node_modules",
    "terminal",
    "colored",
    "zero-dependency",
    "ansi"
  ],
  "author": "Ümit Ulusoy",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "semantic-release": "^25.0.8"
  }
}

{
  "name": "clean-error-stack",
  "version": "1.1.0",
  "description": "Clean up messy Node.js stack traces in development. Filter out node_modules and internal code, focus only on your code.",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./register": {
      "import": "./register.js",
      "require": "./register.cjs"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "register.js",
    "register.cjs"
  ],
  "sideEffects": [
    "./register.js",
    "./register.cjs"
  ],
  "scripts": {
    "test": "echo \"No tests specified yet\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Umit-Ulusoy/clean-error-stack"
  },
  "bugs": {
    "url": "https://github.com/Umit-Ulusoy/clean-error-stack/issues"
  },
  "homepage": "https://github.com/Umit-Ulusoy/clean-error-stack#readme",
  "keywords": [
    "error",
    "stack",
    "trace",
    "clean",
    "filter",
    "debug",
    "development",
    "node_modules",
    "terminal",
    "colored",
    "zero-dependency",
    "ansi"
  ],
  "author": "Ümit Ulusoy",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "semantic-release": "^25.0.8"
  }
}
